---
import { Image } from "astro:assets";
import silhouette from "../assets/bilder/schwangerschaft-fenster.jpg";
import AnfrageFormular from "../komponenten/AnfrageFormular.astro";
import Kapazitaet from "../komponenten/Kapazitaet.astro";
import RueckrufFormular from "../komponenten/RueckrufFormular.astro";
import Seite from "../layouts/Seite.astro";
import { PRAXIS, TEAM, telLink } from "../inhalte/praxis";

const aktiv = TEAM.filter((h) => !h.hinweis);
const betreff = encodeURIComponent("Anfrage Hebammenbetreuung");
const vorlage = encodeURIComponent(
  "Hallo,\n\nich wünsche mir eine Hebammenbetreuung.\n\nVoraussichtlicher Entbindungstermin:\nWohnort:\nGewünschte Leistungen (z. B. Vorsorge, Wochenbett, Kurs):\nErstes Kind? ja / nein\nTelefon:\n\nViele Grüße\n",
);
---

<Seite titel="Kontakt & Betreuung anfragen" beschreibung="Du suchst eine Hebamme in Bad Doberan oder Umgebung? Meldet euch bei der Hebammenpraxis Kindkesmöön – telefonisch oder per E-Mail.">
  <section class="bg-salbei-100">
    <div class="rahmen grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="etikett">Kontakt</p>
        <h1 class="mt-3">Wir freuen uns auf euch</h1>
        <p class="mt-5 text-lg">Du bist interessiert an einer Betreuung oder einem Kurs? Melde dich gerne bei einer der Hebammen. Wir melden uns innerhalb von ein paar Tagen bei dir zurück.</p>
      </div>
      <Image src={silhouette} alt="Silhouette einer Schwangeren am Fenster" widths={[400, 700]} sizes="(min-width: 1024px) 35vw, 100vw" class="hidden aspect-[4/5] w-full rounded-[2.5rem] object-cover lg:block" />
    </div>
  </section>

  <section class="abschnitt scroll-mt-20" id="anfrage">
    <div class="rahmen grid gap-10 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <h2>Betreuung anfragen</h2>
        <p class="mt-4">Tipp: Meldet euch möglichst früh, am besten bis zur 12. Schwangerschaftswoche.</p>
        <div class="mt-6"><Kapazitaet /></div>
        <div class="mt-6">
          <AnfrageFormular>
            <p class="mt-4">Damit wir schnell planen können, schreibt uns bitte:</p>
            <ul class="mt-4 space-y-2">
              {["den voraussichtlichen Entbindungstermin", "euren Wohnort", "welche Leistungen ihr euch wünscht (Vorsorge, Wochenbett, Kurse …)", "ob es euer erstes Kind ist", "wie wir euch am besten erreichen"].map((p) => (
                <li class="flex gap-3"><span class="mt-1 flex size-6 shrink-0 items-center justify-center rounded-full bg-mohn-100 text-sm text-mohn-700" aria-hidden="true">✓</span>{p}</li>
              ))}
            </ul>
          </AnfrageFormular>
        </div>
      </div>

      <ul class="space-y-5">
        {aktiv.map((h) => (
          <li class="karte">
            <div class="flex items-center gap-4">
              <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-salbei-200 font-titel text-xl" aria-hidden="true">{h.kuerzel}</span>
              <div>
                <p class="font-titel text-2xl">{h.name}</p>
                <p class="text-sm text-salbei-600">Hebamme</p>
                <p class="mt-1 text-sm font-semibold text-mohn-700" data-team-status={h.name} hidden></p>
              </div>
            </div>
            <div class="mt-5 flex flex-wrap gap-3">
              {h.telefon && <a class="knopf-sekundaer" href={telLink(h.telefon)}>{h.telefon}</a>}
              <a class="knopf-primaer" href={`mailto:${h.email}?subject=${betreff}&body=${vorlage}`}>E-Mail schreiben</a>
            </div>
          </li>
        ))}
        {TEAM.filter((h) => h.hinweis).map((h) => <li class="px-2 text-sm text-salbei-600">{h.name}: <span data-team-status={h.name}>{h.hinweis}</span></li>)}
        <li class="rounded-2xl bg-salbei-100 px-4 py-3 text-[0.95rem]" data-rufbereitschaft hidden>Heute in Rufbereitschaft: <strong data-rufbereitschaft-name></strong></li>
        <li class="px-2"><a href="#rueckruf" class="font-semibold">Nicht erreicht? Rückruf wünschen ›</a></li>
      </ul>
    </div>
  </section>

  <section class="abschnitt scroll-mt-20 bg-salbei-50" id="rueckruf">
    <div class="rahmen grid gap-10 lg:grid-cols-[1fr_1.5fr]">
      <div>
        <p class="etikett">Lieber telefonieren?</p>
        <h2 class="mt-3">Wir rufen dich zurück</h2>
        <p class="mt-4">Bei Hausbesuchen können wir nicht immer ans Telefon gehen. Hinterlass uns deine Nummer und wann es dir passt – wir melden uns, meist innerhalb von ein, zwei Werktagen.</p>
        <p class="mt-4 text-sm text-salbei-700">In dringenden Fällen (z. B. Fieber, starke Blutungen, Sorgen um dein Baby) wende dich bitte direkt an deine Frauenärztin, die Kinderärztin, die Klinik oder den Notruf 112.</p>
      </div>
      <RueckrufFormular>
        <p class="karte">Ruf uns gern an – die Nummern findest du oben bei den Hebammen. Wenn wir nicht rangehen, sind wir wahrscheinlich bei einem Hausbesuch und rufen zurück.</p>
      </RueckrufFormular>
    </div>
  </section>

  <section class="abschnitt bg-white">
    <div class="rahmen grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-3xl">Praxis</h2>
        <address class="mt-4 text-lg not-italic">{PRAXIS.name}<br />{PRAXIS.strasse}<br />{PRAXIS.plz} {PRAXIS.ort}</address>
        <a href="/praxis" class="mt-4 inline-block font-semibold">Anfahrt &amp; Räume ›</a>
      </div>
      <div>
        <h2 class="text-3xl">Instagram</h2>
        <p class="mt-4">Neuigkeiten, Kurstermine und Einblicke in die Praxis:</p>
        <a href={PRAXIS.instagram} rel="noopener" class="knopf-sekundaer mt-4">{PRAXIS.instagramName}</a>
      </div>
    </div>
  </section>
</Seite>
