---
import Seite from "../layouts/Seite.astro";
---

<Seite titel="Seite nicht gefunden" beschreibung="Diese Seite gibt es nicht (mehr).">
  <section class="abschnitt">
    <div class="rahmen max-w-2xl text-center">
      <p class="font-titel text-7xl text-mohn-300">404</p>
      <h1 class="mt-4">Diese Seite gibt es nicht (mehr)</h1>
      <p class="mt-4">Vielleicht hilft euch eine dieser Seiten weiter:</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a class="knopf-primaer" href="/">Zur Startseite</a>
        <a class="knopf-sekundaer" href="/kurse">Kurse</a>
        <a class="knopf-sekundaer" href="/kontakt">Kontakt</a>
      </div>
    </div>
  </section>
</Seite>
