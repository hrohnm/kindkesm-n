# Adresse, unter der die App erreichbar ist.
# Zum Start der Hostname des Hostinger-VPS (z. B. srv123456.hstgr.cloud), später die Subdomain
# (z. B. app.hebammen-landkreisrostock.de). Caddy holt das HTTPS-Zertifikat automatisch.
DOMAIN=srv000000.hstgr.cloud
# Öffentliche Website (z. B. www.hebammen-landkreisrostock.de); DNS-Eintrag auf den VPS zeigen lassen
WEBSITE_DOMAIN=www.localhost


# Langes, zufälliges Datenbank-Passwort, z. B. erzeugen mit: openssl rand -base64 32
DB_PASSWORT=bitte-aendern

# Laufzeit einer Anmeldung in Stunden
SITZUNG_STUNDEN=12

# Schnellanmeldung mit den Demo-Konten auf der Login-Seite (nur für Test-Umgebungen!)
# ja = Knöpfe für Marielena, Johanna und Lorina werden angezeigt. Im Echtbetrieb: nein
DEMO_MODUS=nein

# Zwei-Faktor-Anmeldung (Authenticator-App) für alle Konten verlangen. Im Echtbetrieb: ja
# Wer sie noch nicht eingerichtet hat, wird nach der Anmeldung durch die Einrichtung geführt.
ZWEI_FAKTOR_PFLICHT=ja

# Routing-Server für Tourenplanung und Wegegeld. Wird von scripts/karte-einrichten.sh gesetzt.
# Leer lassen = Kilometer werden aus der Luftlinie geschätzt (Umwegfaktor 1,3).
OSRM_URL=

# Online-Adresssuche (OpenStreetMap/Nominatim) als Ersatz, wenn das eigene Adressverzeichnis eine Anschrift
# nicht kennt. Übermittelt werden nur Straße, PLZ und Ort (keine Namen). Leer = nominatim.openstreetmap.org,
# "aus" = abgeschaltet (dann nur Adressverzeichnis bzw. Position von Hand). Kontakt-E-Mail laut Nutzungsregeln.
GEOCODER_URL=
GEOCODER_KONTAKT=
